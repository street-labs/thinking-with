---
import Base from '../layouts/Base.astro';
import EditorialBar from '../components/EditorialBar.astro';

import FeaturedLatest from '../components/FeaturedLatest.astro';
import { show } from '../data/podcast';
import { allEpisodes } from '../lib/episodes';
import { u } from '../lib/url';
import { getCollection } from 'astro:content';

// Combined chronological feed of publications (essays + episodes), newest first.
// First 3 are the featured carousel; "The Latest" lists the next 12.
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const essays = (await getCollection('writing')).map((p) => ({
  kind: 'Essay',
  href: u(`/writing/${p.slug}`),
  title: p.data.title,
  description: p.data.description,
  dateLabel: fmt(p.data.date),
  ts: p.data.date.valueOf(),
}));
const eps = allEpisodes
  .filter((ep) => ep.slug)
  .map((ep) => ({
    kind: 'Episode',
    href: u(`/episodes/${ep.slug}`),
    title: ep.title,
    description: ep.description ?? `${ep.seasonAlias} — ${ep.title}`,
    dateLabel: ep.dateLabel,
    ts: new Date(ep.date).valueOf(),
    cover: ep.seasonCover,
  }));
const latest = [...essays, ...eps].sort((a, b) => b.ts - a.ts).slice(3, 15);
---

<Base>
  <!-- EDITORIAL SUB-MENU -->
  <EditorialBar />

  <!-- ROTATING LATEST FEATURE (replaces the old static overview) -->
  <FeaturedLatest />

  <!-- THE LATEST: next 12 publications after the featured three -->
  <section class="section latest">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="eyebrow">The Latest</p>
        </div>
      </div>
      <div class="latest-grid">
        {latest.map((item) => (
          <a
            class:list={['latest-item card', { 'has-cover': !!item.cover, crow: !!item.cover?.includes('crow'), bare: !!item.cover && !item.cover.includes('crow') }]}
            style={item.cover ? `--cover:url(${item.cover})` : undefined}
            href={item.href}
            aria-label={item.cover && !item.cover.includes('crow') ? item.title : undefined}
          >
            <span class="latest-kind">{item.kind}</span>
            <h3 class="latest-title">{item.title}</h3>
            <span class="latest-date muted">{item.dateLabel}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section closing">
    <div class="wrap closing-inner">
      <h2>Think with us.</h2>
      <p class="lede">{show.description}</p>
      <div class="hero-actions">
        <a href={u('/contact#subscribe')} class="btn btn--primary">Join the email list</a>
        <a href={u('/about')} class="btn btn--ghost">About the show</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* shared row heads */
  .row-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.8rem; }
  .row-head .eyebrow { margin-bottom: 0.3rem; }
  .row-link { font-family: var(--font-body); font-weight: 600; font-size: 0.95rem; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .row-link:hover { color: var(--accent-deep); }

  .latest { background: var(--paper-2); }
  /* Season art full-bleed. Crow slide keeps its text under a uniform darkening;
     other seasons' slides are image-only, text hidden. */
  .latest-item.has-cover {
    background-image: linear-gradient(rgba(22, 18, 14, 0.45), rgba(22, 18, 14, 0.45)), var(--cover);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: #f3efe8;
    min-height: 11rem;
    border-left-color: #f0c9a8;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
  .latest-item.bare > span,
  .latest-item.bare > h3 { display: none; }
  .latest-item.has-cover .latest-title { font-size: 1.25rem; color: #f3efe8; }
  /* Crow card: solid black, art full-bleed from the left (bird left, branch
     running off the right edge), text anchored right. */
  .latest-item.crow {
    background-image: var(--cover);
    background-size: auto 50%;
    background-position: left center;
    background-color: #000;
  }
  .latest-item.crow { align-items: flex-end; text-align: right; }
  .latest-item.crow .latest-title { color: #fff; }
  .latest-item.has-cover .latest-date { color: rgba(243, 239, 232, 0.85); }
  .latest-item.has-cover .latest-kind { color: #f0c9a8; }
  .latest-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .latest-item {
    display: flex; flex-direction: column; gap: 0.45rem;
    text-decoration: none; color: inherit;
    border-left: 3px solid var(--accent);
    padding: 1.2rem 1.3rem;
  }
  .latest-item:hover { box-shadow: var(--shadow-lift); }
  .latest-kind {
    font-family: var(--font-body); font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-deep);
  }
  .latest-title { font-size: 1.15rem; margin: 0; line-height: 1.2; }
  .latest-desc { color: var(--ink-soft); margin: 0; font-size: 0.92rem; }
  .latest-date { font-size: 0.8rem; margin-top: auto; }

  .closing { text-align: center; }
  .closing-inner { max-width: 44rem; margin-inline: auto; }
  .closing h2 { font-size: clamp(2rem, 5vw, 3rem); }
  .closing .lede { margin-bottom: 2rem; }

  @media (max-width: 900px) { .latest-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) {
    .latest-grid { grid-template-columns: 1fr; }
    .row-head { flex-direction: column; align-items: flex-start; }
  }
</style>
