---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { u } from '../../lib/url';
import { loadSignedEvents, eventParagraphs } from '../../lib/events';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  const md = posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
  const events = loadSignedEvents().map((e) => ({ params: { slug: e.slug }, props: { event: e } }));
  return [...md, ...events];
}

const props = Astro.props as { post?: CollectionEntry<'writing'>; event?: any };
const signed = props.event ?? null;
const post = props.post!;
const { Content } = signed ? { Content: null } : await post.render();
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={signed ? signed.title : post.data.title} description={signed ? signed.description : post.data.description}>
  <article class="article">
    <div class="wrap prose-wrap">
      <a href={u('/writing')} class="back">← Writing</a>
      <header class="article-head">
        {!signed && post.data.series && <p class="eyebrow">{post.data.series}</p>}
        <h1>{signed ? signed.title : post.data.title}</h1>
        {signed ? <p class="article-desc">{signed.description}</p> : <p class="article-desc">{post.data.description}</p>}
        <p class="article-meta muted">
          {signed ? signed.author : post.data.author} · <time datetime={(signed ? signed.date : post.data.date).toISOString()}>{fmt(signed ? signed.date : post.data.date)}</time>
          {!signed && post.data.draft && <span class="pill draft">Draft</span>}
        </p>
        {signed && (
          <p class="article-meta muted">
            <span class="pill draft">Signed</span>
            <button id="verify-btn" type="button">Verify signature</button>
            <span id="verify-result"></span>
          </p>
        )}
      </header>
      <div class="prose">
        {signed
          ? eventParagraphs(signed.content).map((p) => <p>{p}</p>)
          : <Content />}
      </div>
    </div>
  </article>
</Base>

{signed && (
  <script type="module">
    import { verifyEvent } from '/thinking-with/vendor/nostr-tools.js'
    const ev = ${signed.raw};
    document.getElementById('verify-btn')?.addEventListener('click', () => {
      const ok = verifyEvent(ev)
      document.getElementById('verify-result').textContent = ok
        ? 'Valid - signed by ' + ev.pubkey.slice(0, 8) + '…'
        : 'INVALID signature'
    })
  </script>
)}

<style>
  .article { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .back { font-family: var(--font-body); font-size: 0.9rem; color: var(--ink-soft); text-decoration: none; }
  .back:hover { color: var(--ink); }
  .article-head { margin: 1.2rem 0 2.2rem; }
  .article-head h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .article-desc { font-size: 1.2rem; color: var(--ink-soft); line-height: 1.5; }
  .article-meta { font-size: 0.9rem; display: flex; align-items: center; gap: 0.6rem; }
  .draft { font-size: 0.66rem; }
</style>

<style is:global>
  .prose { font-size: 1.15rem; line-height: 1.75; }
  .prose h2 { font-size: 1.7rem; margin-top: 2.4rem; }
  .prose h3 { font-size: 1.35rem; margin-top: 2rem; }
  .prose blockquote {
    margin: 1.8rem 0;
    padding: 0.6rem 0 0.6rem 1.4rem;
    border-left: 3px solid var(--accent);
    color: var(--ink-soft);
    font-style: italic;
  }
  .prose blockquote p:last-child { margin-bottom: 0; }
  .prose a { color: var(--accent-deep); text-decoration: underline; }
  .prose code {
    background: var(--paper-2);
    padding: 0.1em 0.35em;
    border-radius: 5px;
    font-size: 0.9em;
  }
  .prose img { border-radius: var(--radius); margin: 1.8rem 0; }
</style>
